<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="MaxOrderAmountUSD" value="250000" />
		<add key="DefaultCurrency" value="USD" />
	</appSettings>

	<connectionStrings>
		<add name="PortfolioDb" connectionString="Data Source=.;Initial Catalog=PortfolioDb;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.7"  />
		<httpRuntime targetFramework="4.7" maxRequestLength="51200" executionTimeout="3600" />
		<sessionState mode="InProc" timeout="30" />
		<trace enabled="true" />


	</system.web>

	<system.webServer>
		<modules>
			<add name="ComplianceTraceModule" type="PortfolioOrderApp.Infrastructure.ComplianceTraceModule" />
		</modules>
		<validation validateIntegratedModeConfiguration="false" />
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="52428800" />
			</requestFiltering>
		</security>
	</system.webServer>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
