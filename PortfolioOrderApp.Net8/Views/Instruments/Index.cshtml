
@model System.Collections.Generic.List<PortfolioOrderApp.Net8.Models.Instrument>

<h1>Catalogo de instrumentos</h1>

<table>
    <tr>
        <th>Ticker</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Precio</th>
        <th></th>
    </tr>

    @foreach (var instrument in Model)
    {
        <tr>
            <td>@instrument.Ticker</td>
            <td>@instrument.Name</td>
            <td>@instrument.AssetType</td>
            <td>@instrument.Price.ToString("C")</td>
            <td>
                @using (Html.BeginForm("Add", "OrderTicket", FormMethod.Post))
                {
                    @Html.Hidden("instrumentId", instrument.Id)
                    @Html.Hidden("ticker", instrument.Ticker)

                    <select name="side">
                        <option value="Compra">Compra</option>
                        <option value="Venta">Venta</option>
                    </select>

                    @Html.TextBox("quantity", 1)

                    <button type="submit">Agregar a orden</button>
                }
            </td>
        </tr>
    }
</table>

<p>@Html.ActionLink("Ver orden actual", "Index", "OrderTicket")</p>
